# ── Postgres (compose + backend) ─────────────────────────────────────────────
POSTGRES_USER=scout
POSTGRES_PASSWORD=scout
POSTGRES_DB=scout
POSTGRES_PORT=5432

# ── Ports ────────────────────────────────────────────────────────────────────
BACKEND_PORT=7001
FRONTEND_PORT=3100

# ── Backend ──────────────────────────────────────────────────────────────────
SCOUT_DEBUG=true
# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:3100

# ── Frontend (build-time) ────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:7001
