# ── Postgres (compose + backend) ─────────────────────────────────────────────
POSTGRES_USER=scout
POSTGRES_PASSWORD=scout
POSTGRES_DB=scout
POSTGRES_PORT=5432

# ── Ports ────────────────────────────────────────────────────────────────────
BACKEND_PORT=7001
FRONTEND_PORT=3100

# ── Backend ──────────────────────────────────────────────────────────────────
SCOUT_DEBUG=true
# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:3100

# ── LLM (OpenAI-compatible; GLM) ─────────────────────────────────────────────
LLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-4.6
LLM_FAST_MODEL=glm-4.5-air

# ── Frontend (build-time) ────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:7001
